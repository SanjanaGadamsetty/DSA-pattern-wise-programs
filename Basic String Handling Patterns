5. FIND LENGTH UNTIL SPECIFIC CHARACTER OCCURS

// To find length until a character occurs
int main()
{
    char str[1000];
    fgets(str,sizeof(str),stdin);
    char ch;
    scanf(" %c",&ch);
    int len=0;
    for (int i=0;str[i]!='\n' && str[i]!='\0';i++)
    {
        if (str[i]==ch)
        {
            break;
        }
        len++;
    }
    printf("%d",len);
    return 0;
}



