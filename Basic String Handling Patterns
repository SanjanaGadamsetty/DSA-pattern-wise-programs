1. FINDING STRING LENGTH

// To find string length
int main()
{
    char str[1000];
    int c=0;
    if (fgets(str,sizeof(str),stdin)!=NULL)
    {
        for (int i=0;str[i];i++)
        {
            c++;
        }
    }
    printf("%d",c);
    return 0;
}



2. LENGTH OF STR USING WHILE LOOP

// String len using while loop
int main()
{
    char str[1000];
    int i=0;
    if (fgets(str,sizeof(str),stdin)!=NULL)
    {
        while (str[i]!='\0'&&str[i]!='\n')
        {
            i++;
        }
    }
    printf("%d",i);
    return 0;
}



3. LENGTH OF STRING IS EVEN OR ODD

// Len of str is even or odd
int count(char str[])
{
    int len=0;
