4. COUNT TOTAL CHARACTERS UNTIL '\0'

// To count total characters
int main()
{
    char str[1000];
    int c=0;
    if (fgets(str,sizeof(str),stdin)!=NULL)
    {
        for (int i=0;str[i];i++)
        {
            c++;
