### TRAVERSING A STRING USING LOOPS



1. PRINT EACH CHARACTER IN A NEW LINE

// Print Each char in a new line
int main()
{
    char str[1000];
    scanf("%[^\n]",str);
    for (int i=0;str[i];i++)
    {
        printf("%c\n",str[i]);
    }
    return 0;
}
// Print each char in a new line(Safer version)
int main()
{
    char str[1000];
    if (fgets(str,sizeof(str),stdin)!=NULL)
    {
        for (int i=0;str[i];i++)
        {
            printf("%c\n",str[i]);
        }
    }
    return 0;
}



2. PRINT CHARACTERS AT EVEN/ODD POSITIONS

// Chars at even/odd positions
int main()
{
    char s[1000];
    if (fgets(s,sizeof(s),stdin)!=NULL)
    {
        printf("Chars at even positions:\n");
        for (int i=1;s[i];i+=2)
        {
            if (i%2!=0)
            {
                printf("%c ",s[i]);
            }
        }
        printf("\nChars at odd positions:\n");
        for (int i=0;s[i];i+=2)
        {
            if (i%2==0)
            {
                printf("%c ",s[i]);
            }
        }
    }
    return 0;
}



