1. REVERSE A STRING IN-PLACE USING 2-POINTERS

// Reverse in-place using 2-pointers
void reverse(char str[],int len){
    int start=0,end=len-1;
    while (start<end){
        int temp=str[start];
        str[start]=str[end];
        str[end]=temp;
        start++; end--;
    }    
    printf("Reversed string: %s",str);
    return;
}
int main(){
    char str[1000];
    scanf("%s",str);
    int len=strlen(str);
    reverse(str,len);
    return 0;
}



2. REVERSE ONLY ALPHABETIC CHARACTERS, KEEPING DIGITS IN-PLACE

// Reverse only alphabetic characters in a string, keeping digits in-place

void reverse_alpha(char *str){
    int left=0,right=strlen(str)-1;
    while (left<right){
        if (!isalpha(str[left])){
            left++;
        }
        else if(!isalpha(str[right])){
            right--;
        }
        else{
            char temp=str[left];
            str[left]=str[right];
            str[right]=temp;
            left++;
            right--;
        }
    }
    printf("%s",str);
    return;
}
int main(){
    char str[1000];
    fgets(str,1000,stdin);
    str[strlen(str)-1]='\0';
    reverse_alpha(str);
    return 0;
}



